# Telegram bot that receives booking requests (server-only, never exposed to the browser)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public site URL, e.g. https://brightsmile.dental (used for SEO links)
NEXT_PUBLIC_SITE_URL=

# Optional, for local testing only: send Telegram requests to a stub server
# instead of https://api.telegram.org. Leave unset in production.
# TELEGRAM_API_URL=http://localhost:4010
